gpd\nfrom shapely import wkt\nfrom io import StringIO\nimport io\nimport pyarrow as pa\nimport pyarrow.parquet as pq\nimport json","metadata":{"trusted":true,"tags":[]},"execution_count":3,"outputs":[]},{"cell_type":"code","source":"s3 = boto3.client('s3')\n\n# 🔧 Caminhos dos arquivos na camada RAW\nbucket_name = 'tcc-eng-software-vilas-favelas-bh'\nvilas_key = 'raw/vilas-favelas-bh.csv'\nbairros_key = 'raw/bairro-oficial.csv'\n\n# ✅ Lê CSV de vilas e favelas\nresponse_vilas = s3.get_object(Bucket=bucket_name, Key=vilas_key)\ncsv_vilas = response_vilas['Body'].read().decode('utf-8')\ndf_vilas_favelas = pd.read_csv(StringIO(csv_vilas))\n\n# ✅ Lê CSV de bairros oficiais\nresponse_bairros = s3.get_object(Bucket=bucket_name, Key=bairros_key)\ncsv_bairros = response_bairros['Body'].read().decode('utf-8')\ndf_bairros = pd.read_csv(StringIO(csv_bairros))\n\n# ✅ Exibe as primeiras linhas dos dois DataFrames\nprint(\"🗺️  Vilas e Favelas:\")\nprint(df_vilas_favelas.head())\n\nprint(\"\\n🏙️  Bairros Oficiais:\")\nprint(df_bairros.head())","metadata":{"trusted":true,"tags":[]},"execution_count":4,"outputs":[{"name":"stdout","text":"🗺️  Vilas e Favelas:\n                FID  ID_VILA_FAVELA                  NOME_LOCALIDADE  \\\n0  VILA_FAVELA.1510            1510          Barão Homem de Melo III   \n1  VILA_FAVELA.1463            1463                  Vila Mangueiras   \n2  VILA_FAVELA.1405            1405                  Vila Ouro Minas   \n3  VILA_FAVELA.1328            1328  Conjunto São Francisco de Assis   \n4  VILA_FAVELA.1394            1394              Vila Novo São Lucas   \n\n  APELIDO_LOCALIDADE                         DESC_LOCALIDADE  QTDE_DOMICILIO  \\\n0                NaN                           Vila / Favela              58   \n1            Antenas                           Vila / Favela             573   \n2         Fazendinha                           Vila / Favela             184   \n3    Trevo / Braúnas  Loteamento Público de Interesse Social              89   \n4                NaN                           Vila / Favela             980   \n\n                                FONTE_DOMICILIO DATA_QTDE_DOMICILIO  \\\n0  URBEL - Estudo Proporcional sobre Censo 2010          01/12/2014   \n1                             IBGE - Censo 2010          01/12/2014   \n2  URBEL - Estudo Proporcional sobre Censo 2010          01/12/2014   \n3                             IBGE - Censo 2010          01/12/2014   \n4  URBEL - Estudo Proporcional sobre Censo 2010          01/12/2014   \n\n   QTDE_ESTABELECIMENTO                         FONTE_ESTABELECIMENTO  \\\n0                     4  URBEL - Estudo Proporcional sobre Censo 2010   \n1                    43                             IBGE - Censo 2010   \n2                     4  URBEL - Estudo Proporcional sobre Censo 2010   \n3                     6                             IBGE - Censo 2010   \n4                    64  URBEL - Estudo Proporcional sobre Censo 2010   \n\n  DATA_QTDE_ESTABELECIMENTO  QTDE_POPULACAO_EXISTENTE  \\\n0                01/12/2014                       182   \n1                01/12/2014                      1903   \n2                01/12/2014                       647   \n3                01/12/2014                       300   \n4                01/12/2014                      3436   \n\n                      FONTE_POPULACAO_EXISTENTE DATA_INFO_POP_EXISTENTE  \\\n0  URBEL - Estudo Proporcional sobre Censo 2010              01/12/2014   \n1                             IBGE - Censo 2010              01/12/2014   \n2  URBEL - Estudo Proporcional sobre Censo 2010              01/12/2014   \n3                             IBGE - Censo 2010              01/12/2014   \n4  URBEL - Estudo Proporcional sobre Censo 2010              01/12/2014   \n\n  PLANO_URBANISTICO                                          GEOMETRIA  \n0               Sim  MULTIPOLYGON (((607596.555052356 7794516.23748...  \n1               Sim  MULTIPOLYGON (((600523.576781815 7786596.26824...  \n2               Sim  MULTIPOLYGON (((614106.587050401 7805290.31118...  \n3               Não  MULTIPOLYGON (((603504.080812885 7806926.82835...  \n4               Sim  MULTIPOLYGON (((614277.415731508 7795920.39820...  \n\n🏙️  Bairros Oficiais:\n                  FID  ID_BAC  CODIGO    TIPO        NOME  AREA_KM2  \\\n0  BAIRRO_OFICIAL.239     239     437  Bairro   Esplanada     1.147   \n1   BAIRRO_OFICIAL.17      17     303  Bairro  das Garças     1.184   \n2   BAIRRO_OFICIAL.31      31     947  Bairro    Planalto     2.458   \n3   BAIRRO_OFICIAL.37      37     942  Bairro    Floramar     1.410   \n4   BAIRRO_OFICIAL.67      67     776  Bairro     Vitória     6.674   \n\n   PERIMETR_M                                          GEOMETRIA  \n0    5007.791  MULTIPOLYGON (((614359.85860661 7799103.307353...  \n1    6000.087  MULTIPOLYGON (((604196.7024996 7806824.1586111...  \n2   10177.977  MULTIPOLYGON (((609677.242142008 7807927.61915...  \n3    7092.314  MULTIPOLYGON (((610801.676194471 7807071.49866...  \n4   14454.596  MULTIPOLYGON (((618535.289214476 7805651.58890...  \n","output_type":"stream"}]},{"cell_type":"code","source":"# Vilas e favelas — Drop colunas desnecessárias\ndf_vilas_favelas = df_vilas_favelas.drop(columns=[\n    'FID', 'APELIDO_LOCALIDADE', 'DESC_LOCALIDADE', \n    'FONTE_DOMICILIO', 'DATA_QTDE_DOMICILIO', 'QTDE_ESTABELECIMENTO',\n    'FONTE_ESTABELECIMENTO', 'DATA_QTDE_ESTABELECIMENTO', \n    'FONTE_POPULACAO_EXISTENTE', 'DATA_INFO_POP_EXISTENTE', \n    'PLANO_URBANISTICO', 'QTDE_DOMICILIO', 'QTDE_POPULACAO_EXISTENTE'\n])\n\n# Padroniza nomes de colunas\ndf_vilas_favelas.columns = df_vilas_favelas.columns.str.lower()\n\n# Renomeia\ndf_vilas_favelas = df_vilas_favelas.rename(columns={'nome_localidade': 'localidade'})","metadata":{"trusted":true,"tags":[]},"execution_count":5,"outputs":[]},{"cell_type":"code","source":"# Bairros — Drop colunas desnecessárias\ndf_bairros = df_bairros.drop(columns=[\n    'FID', 'ID_BAC', 'CODIGO', 'TIPO', 'AREA_KM2', 'PERIMETR_M'\n])\n\ndf_bairros.columns = df_bairros.columns.str.lower()\ndf_bairros = df_bairros.rename(columns={'nome': 'localidade'})","metadata":{"trusted":true,"tags":[]},"execution_count":6,"outputs":[]},{"cell_type":"code","source":"import re\nimport unicodedata\n\n# Função de normalização\ndef normalizar(texto):\n    if pd.isna(texto):\n        return \"\"\n    texto = texto.lower()\n    texto = unicodedata.normalize(\"NFKD\", texto).encode(\"ASCII\", \"ignore\").decode(\"utf-8\")\n    texto = re.sub(r\"[-]\", \" \", texto) \n    texto = re.sub(r'\\b(vila|favela|comunidade|bairro)\\b', '', texto)\n    texto = re.sub(r\"\\s+\", \" \", texto)\n    return texto.strip()\n\n# Aplica normalização\ndf_vilas_favelas['localidade'] = df_vilas_favelas['localidade'].apply(normalizar)\ndf_bairros['localidade'] = df_bairros['localidade'].apply(normalizar)","metadata":{"trusted":true,"tags":[]},"execution_count":7,"outputs":[]},{"cell_type":"code","source":"print(\"🗺️  Vilas e Favelas:\")\nprint(df_vilas_favelas.head())\n\nprint(\"\\n🏙️  Bairros Oficiais:\")\nprint(df_bairros.head())","metadata":{"trusted":true,"tags":[]},"execution_count":8,"outputs":[{"name":"stdout","text":"🗺️  Vilas e Favelas:\n   id_vila_favela                       localidade  \\\n0            1510          barao homem de melo iii   \n1            1463                       mangueiras   \n2            1405                       ouro minas   \n3            1328  conjunto sao francisco de assis   \n4            1394                   novo sao lucas   \n\n                                           geometria  \n0  MULTIPOLYGON (((607596.555052356 7794516.23748...  \n1  MULTIPOLYGON (((600523.576781815 7786596.26824...  \n2  MULTIPOLYGON (((614106.587050401 7805290.31118...  \n3  MULTIPOLYGON (((603504.080812885 7806926.82835...  \n4  MULTIPOLYGON (((614277.415731508 7795920.39820...  \n\n🏙️  Bairros Oficiais:\n   localidade                                          geometria\n0   esplanada  MULTIPOLYGON (((614359.85860661 7799103.307353...\n1  das garcas  MULTIPOLYGON (((604196.7024996 7806824.1586111...\n2    planalto  MULTIPOLYGON (((609677.242142008 7807927.61915...\n3    floramar  MULTIPOLYGON (((610801.676194471 7807071.49866...\n4     vitoria  MULTIPOLYGON (((618535.289214476 7805651.58890...\n","output_type":"stream"}]},{"cell_type":"code","source":"# Converter a coluna WKT para geometria shapely na coluna 'geometry'\ndf_vilas_favelas['geometry'] = df_vilas_favelas['geometria'].apply(wkt.loads)\ndf_bairros['geometry'] = df_bairros['geometria'].apply(wkt.loads)\n\n# Criar GeoDataFrame, informando que a geometria está na coluna 'geometry'\ndf_vilas_favelas = gpd.GeoDataFrame(df_vilas_favelas, geometry='geometry')\ndf_bairros = gpd.GeoDataFrame(df_bairros, geometry='geometry')","metadata":{"trusted":true,"tags":[]},"execution_count":9,"outputs":[]},{"cell_type":"code","source":"df_vilas_favelas = df_vilas_favelas.drop(columns=['geometria'])\ndf_bairros = df_bairros.drop(columns=['geometria'])","metadata":{"trusted":true,"tags":[]},"execution_count":10,"outputs":[]},{"cell_type":"code","source":"df_vilas_favelas[\"tipo\"] = \"vilas_favelas\"\ndf_bairros[\"tipo\"] = \"bairro\"\n\n# 5. Concatenar GeoDataFrames\ngdf_unificado = gpd.GeoDataFrame(pd.concat([df_vilas_favelas, df_bairros], ignore_index=True))\n\n# 6. Setar CRS original se não estiver definido (exemplo EPSG:31983)\nif gdf_unificado.crs is None:\n    gdf_unificado.set_crs(epsg=31983, inplace=True)\n\ngdf_unificado[\"centroide\"] = gdf_unificado.geometry.centroid\n\n# 3. Criar GeoSeries só com os centroides (em EPSG:31983)\ngdf_centroides = gpd.GeoSeries(gdf_unificado[\"centroide\"], crs=gdf_unificado.crs)\n\n# 4. Converter os centroides para EPSG:4326 (lat/lon)\ngdf_centroides_wgs84 = gdf_centroides.to_crs(epsg=4326)\n\n# 5. Extrair latitude e longitude\ngdf_unificado[\"latitude\"] = gdf_centroides_wgs84.y\ngdf_unificado[\"longitude\"] = gdf_centroides_wgs84.x\n\ngdf_unificado[\"latitude\"] = gdf_unificado[\"latitude\"].astype(float)\ngdf_unificado[\"longitude\"] = gdf_unificado[\"longitude\"].astype(float)\n\n# 8. Criar nova coluna com a geometria em formato GeoJSON (string)\ngdf_unificado[\"geometry_geojson\"] = gdf_unificado[\"geometry\"].apply(lambda geom: geom.__geo_interface__ if geom else None)\ngdf_unificado[\"geometry_geojson\"] = gdf_unificado[\"geometry_geojson\"].apply(json.dumps)\n\n# 9. Selecionar colunas para exportar, renomeando a coluna GeoJSON para \"geometry\"\ngdf_export = gdf_unificado[[\"id_vila_favela\", \"localidade\", \"tipo\", \"geometry_geojson\"]].copy()\ngdf_export.rename(columns={\"geometry_geojson\": \"geometry\"}, inplace=True)\n","metadata":{"trusted":true,"tags":[]},"execution_count":19,"outputs":[]},{"cell_type":"code","source":"gdf_unificado.head()","metadata":{"trusted":true,"tags":[]},"execution_count":20,"outputs":[{"execution_count":20,"output_type":"execute_result","data":{"text/plain":"   id_vila_favela                       localidade  \\\n0          1510.0          barao homem de melo iii   \n1          1463.0                       mangueiras   \n2          1405.0                       ouro minas   \n3          1328.0  conjunto sao francisco de assis   \n4          1394.0                   novo sao lucas   \n\n                                            geometry           tipo  \\\n0  MULTIPOLYGON (((607596.555 7794516.237, 607603...  vilas_favelas   \n1  MULTIPOLYGON (((600523.577 7786596.268, 600537...  vilas_favelas   \n2  MULTIPOLYGON (((614106.587 7805290.311, 614104...  vilas_favelas   \n3  MULTIPOLYGON (((603504.081 7806926.828, 603493...  vilas_favelas   \n4  MULTIPOLYGON (((614277.416 7795920.398, 614239...  vilas_favelas   \n\n                        centroide   latitude  longitude  \\\n0  POINT (607622.914 7794557.248) -19.942454 -43.971568   \n1  POINT (600885.506 7786413.023) -20.016402 -44.035495   \n2  POINT (614079.717 7805190.064) -19.846017 -43.910533   \n3  POINT (603539.648 7806875.109) -19.831378 -44.011273   \n4  POINT (614157.682 7795624.164) -19.932442 -43.909196   \n\n                                    geometry_geojson  \n0  {\"type\": \"MultiPolygon\", \"coordinates\": [[[[60...  \n1  {\"type\": \"MultiPolygon\", \"coordinates\": [[[[60...  \n2  {\"type\": \"MultiPolygon\", \"coordinates\": [[[[61...  \n3  {\"type\": \"MultiPolygon\", \"coordinates\": [[[[60...  \n4  {\"type\": \"MultiPolygon\", \"coordinates\": [[[[61...  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>id_vila_favela</th>\n      <th>localidade</th>\n      <th>geometry</th>\n      <th>tipo</th>\n      <th>centroide</th>\n      <th>latitude</th>\n      <th>longitude</th>\n      <th>geometry_geojson</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>1510.0</td>\n      <td>barao homem de melo iii</td>\n      <td>MULTIPOLYGON (((607596.555 7794516.237, 607603...</td>\n      <td>vilas_favelas</td>\n      <td>POINT (607622.914 7794557.248)</td>\n      <td>-19.942454</td>\n      <td>-43.971568</td>\n      <td>{\"type\": \"MultiPolygon\", \"coordinates\": [[[[60...</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>1463.0</td>\n      <td>mangueiras</td>\n      <td>MULTIPOLYGON (((600523.577 7786596.268, 600537...</td>\n      <td>vilas_favelas</td>\n      <td>POINT (600885.506 7786413.023)</td>\n      <td>-20.016402</td>\n      <td>-44.035495</td>\n      <td>{\"type\": \"MultiPolygon\", \"coordinates\": [[[[60...</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>1405.0</td>\n      <td>ouro minas</td>\n      <td>MULTIPOLYGON (((614106.587 7805290.311, 614104...</td>\n      <td>vilas_favelas</td>\n      <td>POINT (614079.717 7805190.064)</td>\n      <td>-19.846017</td>\n      <td>-43.910533</td>\n      <td>{\"type\": \"MultiPolygon\", \"coordinates\": [[[[61...</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>1328.0</td>\n      <td>conjunto sao francisco de assis</td>\n      <td>MULTIPOLYGON (((603504.081 7806926.828, 603493...</td>\n      <td>vilas_favelas</td>\n      <td>POINT (603539.648 7806875.109)</td>\n      <td>-19.831378</td>\n      <td>-44.011273</td>\n      <td>{\"type\": \"MultiPolygon\", \"coordinates\": [[[[60...</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>1394.0</td>\n      <td>novo sao lucas</td>\n      <td>MULTIPOLYGON (((614277.416 7795920.398, 614239...</td>\n      <td>vilas_favelas</td>\n      <td>POINT (614157.682 7795624.164)</td>\n      <td>-19.932442</td>\n      <td>-43.909196</td>\n      <td>{\"type\": \"MultiPolygon\", \"coordinates\": [[[[61...</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}]},{"cell_type":"code","source":"gdf_export = gdf_unificado[[\"localidade\", \"tipo\", \"latitude\", \"longitude\"]].copy()\ngdf_export.rename(columns={\"geometry_geojson\": \"geometry\"}, inplace=True)\ngdf_export.head()","metadata":{"trusted":true,"tags":[]},"execution_count":22,"outputs":[{"execution_count":22,"output_type":"execute_result","data":{"text/plain":"                        localidade           tipo   latitude  longitude\n0          barao homem de melo iii  vilas_favelas -19.942454 -43.971568\n1                       mangueiras  vilas_favelas -20.016402 -44.035495\n2                       ouro minas  vilas_favelas -19.846017 -43.910533\n3  conjunto sao francisco de assis  vilas_favelas -19.831378 -44.011273\n4                   novo sao lucas  vilas_favelas -19.932442 -43.909196","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>localidade</th>\n      <th>tipo</th>\n      <th>latitude</th>\n      <th>longitude</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>barao homem de melo iii</td>\n      <td>vilas_favelas</td>\n      <td>-19.942454</td>\n      <td>-43.971568</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>mangueiras</td>\n      <td>vilas_favelas</td>\n      <td>-20.016402</td>\n      <td>-44.035495</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>ouro minas</td>\n      <td>vilas_favelas</td>\n      <td>-19.846017</td>\n      <td>-43.910533</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>conjunto sao francisco de assis</td>\n      <td>vilas_favelas</td>\n      <td>-19.831378</td>\n      <td>-44.011273</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>novo sao lucas</td>\n      <td>vilas_favelas</td>\n      <td>-19.932442</td>\n      <td>-43.909196</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}]},{"cell_type":"code","source":"# 8. Converte para Parquet em memória \ntable = pa.Table.from_pandas(gdf_export)\nparquet_buffer = io.BytesIO()\npq.write_table(table, parquet_buffer, compression='snappy')\nparquet_buffer.seek(0)","metadata":{"trusted":true,"tags":[]},"execution_count":23,"outputs":[{"execution_count":23,"output_type":"execute_result","data":{"text/plain":"0"},"metadata":{}}]},{"cell_type":"code","source":"s3_bucket = \"tcc-eng-software-vilas-favelas-bh\"\ns3_key = \"processed/vilas_favelas/vilas-favelas-unificado.parquet\"\n\ns3 = boto3.client(\"s3\")\ns3.put_object(Bucket=s3_bucket, Key=s3_key, Body=parquet_buffer.getvalue())\n\nprint(f\"✅ Arquivo Parquet enviado para s3://{s3_bucket}/{s3_key}\")","metadata":{"trusted":true,"tags":[]},"execution_count":24,"outputs":[{"name":"stdout","text":"✅ Arquivo Parquet enviado para s3://tcc-eng-software-vilas-favelas-bh/processed/vilas_favelas/vilas-favelas-unificado.parquet\n","output_type":"stream"}]},{"cell_type":"code","source":"import folium\nfrom folium import GeoJson\nfrom shapely import wkt\nfrom folium.features import GeoJsonTooltip\n\ndf_vilas_favelas[\"geometry\"] = df_vilas_favelas[\"geometria\"].apply(wkt.loads)\ndf_bairros [\"geometry\"] = df_bairros[\"geometria\"].apply(wkt.loads)\n\ngdf_vilas_favelas = gpd.GeoDataFrame(df_vilas_favelas, geometry=\"geometry\", crs=\"EPSG:31983\")\ngdf_bairros = gpd.GeoDataFrame(df_bairros, geometry=\"geometry\", crs=\"EPSG:31983\")\n\ngdf_vilas_favelas = gdf_vilas_favelas.to_crs(epsg=4326)\ngdf_bairros = gdf_bairros.to_crs(epsg=4326)\n\ngdf_proj = gdf_vilas_favelas.to_crs(epsg=31983)\ncentroid = gdf_proj.geometry.centroid\n\ncentroid_wgs84 = centroid.to_crs(epsg=4326)\n\ncenter_lat = centroid_wgs84.y.mean()\ncenter_lon = centroid_wgs84.x.mean()\n\ngdf_vilas_favelas['localidade'] = gdf_vilas_favelas['localidade'].astype(str).str.strip()\ngdf_bairros['localidade'] = gdf_bairros['localidade'].astype(str).str.strip().str.lower()\n\nshow_map = folium.Map(\n    location=[center_lat, center_lon], \n    zoom_start=12,\n    tiles=\"CartoDB Positron\"\n)\n\ndef gray_map(feature):\n    return {\n        'fillColor': '#d3d3d3',\n        'color': '#d3d3d3',\n        'weight': 1,\n        'fillOpacity': 0.5\n    }\n\n# Style function for village and favela polygons\ndef vilas_favelas_map(feature):\n    return {\n        'fillColor': '#ff7800',\n        'color': '#ff7800',\n        'weight': 2,\n        'fillOpacity': 0.7\n    }\n\n# 11. Adds background polygons to the map\nfolium.GeoJson(\n    gdf_bairros,\n    style_function=gray_map\n).add_to(show_map)\n\n# 14. Adds village and favela polygons to the map\ngeojson_vilas_favelas = folium.GeoJson(\n    gdf_vilas_favelas,\n    style_function=vilas_favelas_map,\n    tooltip=GeoJsonTooltip(fields=[\"localidade\"], aliases=[\"Localidade:\"])\n)\n\ngeojson_vilas_favelas.add_to(show_map)\n\n# 15. Display the map on the notebook\nshow_map","metadata":{"trusted":true,"tags":[]},"execution_count":8,"outputs":[{"execution_count":8,"output_type":"execute_result","data":{"text/plain":"<folium.folium.Map at 0x7ff356ea50a0>","text/html":"<div style=\"width:100%;\"><div style=\"position:relative;width:100%;height:0;padding-bottom:60%;\"><span style=\"color:#565656\">Make this Notebook Trusted to load map: File -> Trust Notebook</span><iframe srcdoc=\"&lt;!DOCTYPE html&gt;\n&lt;html&gt;\n&lt;head&gt;\n    \n    &lt;meta http-equiv=&quot;content-type&quot; content=&quot;text/html; charset=UTF-8&quot; /&gt;\n    \n        &lt;script&gt;\n            L_NO_TOUCH = false;\n            L_DISABLE_3D = false;\n        &lt;/script&gt;\n    \n    &lt;style&gt;html, body {width: 100%;height: 100%;margin: 0;padding: 0;}&lt;/style&gt;\n    &lt;style&gt;#map {position:absolute;top:0;bottom:0;right:0;left:0;}&lt;/style&gt;\n    &lt;script src=&quot;https://cdn.jsdelivr.net/npm/leaflet@1.9.3/dist/leaflet.js&quot;&gt;&lt;/script&gt;\n    &lt;script src=&quot;https://code.jquery.com/jquery-3.7.1.min.js&quot;&gt;&lt;/script&gt;\n    &lt;script src=&quot;https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js&quot;&gt;&lt;/script&gt;\n    &lt;script src=&quot;https://cdnjs.cloudflare.com/ajax/libs/Leaflet.awesome-markers/2.0.2/leaflet.awesome-markers.js&quot;&gt;&lt;/script&gt;\n    &lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdn.jsdelivr.net/npm/leaflet@1.9.3/dist/leaflet.css&quot;/&gt;\n    &lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css&quot;/&gt;\n    &lt;link rel=&quot;stylesheet&quot; href=&quot;https://netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap-glyphicons.css&quot;/&gt;\n    &lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.2.0/css/all.min.css&quot;/&gt;\n    &lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdnjs.cloudflare.com/ajax/libs/Leaflet.awesome-markers/2.0.2/leaflet.awesome-markers.css&quot;/&gt;\n    &lt;link rel=&quot;stylesheet&quot; href=&quot;https://cdn.jsdelivr.net/gh/python-visualization/folium/folium/templates/leaflet.awesome.rotate.min.css&quot;/&gt;\n    \n            &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width,\n                initial-scale=1.0, maximum-scale=1.0, user-scalable=no&quot; /&gt;\n            &lt;style&gt;\n                #map_9ef97edb99c577d505bc2b2a6d3fe8b7 {\n                    position: relative;\n                    width: 100.0%;\n                    height: 100.0%;\n                    left: 0.0%;\n                    top: 0.0%;\n                }\n                .leaflet-container { font-size: 1rem; }\n            &lt;/style&gt;\n        \n    \n                    &lt;style&gt;\n                        .foliumtooltip {\n                            \n                        }\n                       .foliumtooltip table{\n                            margin: auto;\n                        }\n                        .foliumtooltip tr{\n                            text-align: left;\n                        }\n                        .foliumtooltip th{\n                            padding: 2px; padding-right: 8px;\n                        }\n                    &lt;/style&gt;\n            \n&lt;/head&gt;\n&lt;body&gt;\n    \n    \n            &lt;div class=&quot;folium-map&quot; id=&quot;map_9ef97edb99c577d505bc2b2a6d3fe8b7&quot; &gt;&lt;/div&gt;\n        \n&lt;/body&gt;\n&lt;script&gt;\n    \n    \n            var map_9ef97edb99c577d505bc2b2a6d3fe8b7 = L.map(\n                &quot;map_9ef97edb99c577d505bc2b2a6d3fe8b7&quot;,\n                {\n                    center: [-19.905708995120456, -43.95999697543501],\n                    crs: L.CRS.EPSG3857,\n                    ...{\n  &quot;zoom&quot;: 12,\n  &quot;zoomControl&quot;: true,\n  &quot;preferCanvas&quot;: false,\n}\n\n                }\n            );\n\n            \n\n     