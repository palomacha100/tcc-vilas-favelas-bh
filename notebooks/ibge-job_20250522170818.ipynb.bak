>\n      <td>18</td>\n      <td>-</td>\n      <td>-</td>\n      <td>-</td>\n      <td>-</td>\n      <td>-</td>\n      <td>1</td>\n      <td>-</td>\n      <td>-</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>Vila Paquetá - Belo Horizonte (MG)</td>\n      <td>Homens</td>\n      <td>45 a 54 anos</td>\n      <td>-</td>\n      <td>12</td>\n      <td>-</td>\n      <td>21</td>\n      <td>-</td>\n      <td>-</td>\n      <td>-</td>\n      <td>1</td>\n      <td>-</td>\n      <td>-</td>\n      <td>-</td>\n      <td>-</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}]},{"cell_type":"code","source":"df_ibge = df_ibge.drop(columns=['Sem declaração.1'])","metadata":{"trusted":true,"editable":true},"execution_count":9,"outputs":[]},{"cell_type":"code","source":"import numpy as np\n\n# Replace \"-\" with NaN and convert to numeric\ndf_ibge = df_ibge.replace(\"-\", np.nan)\ndf_ibge.iloc[:, 3:] = df_ibge.iloc[:, 3:].apply(pd.to_numeric, errors=\"coerce\")\n\n# Melt columns without and with .1 separately\nalfabetizado = df_ibge.melt(\n    id_vars=['Favela e Comunidade Urbana 2022', 'Sexo', 'Grupo de idade'],\n    value_vars=['Branca', 'Preta', 'Amarela', 'Parda', 'Indígena'],\n    var_name='raca',\n    value_name='quantidade'\n)\nalfabetizado['situacao'] = 'alfabetizado'\n\nnao_alfabetizado = df_ibge.melt(\n    id_vars=['Favela e Comunidade Urbana 2022', 'Sexo', 'Grupo de idade'],\n    value_vars=['Branca.1', 'Preta.1', 'Amarela.1', 'Parda.1', 'Indígena.1'],\n    var_name='raca',\n    value_name='quantidade'\n)\nnao_alfabetizado['situacao'] = 'nao_alfabetizado'\n\n# Remove .1 from breed name\nnao_alfabetizado['raca'] = nao_alfabetizado['raca'].str.replace('.1', '', regex=False)\n\n# Join the two parts\ndf_ibge = pd.concat([alfabetizado, nao_alfabetizado], ignore_index=True)\n\n# Rename columns\ndf_ibge.rename(columns={\n    'Favela e Comunidade Urbana 2022': 'local',\n    'Sexo': 'sexo',\n    'Grupo de idade': 'faixa_etaria'\n}, inplace=True)\n\ndf_ibge['local'] = df_ibge['local'].str.replace(' - Belo Horizonte (MG)', '', regex=False)\n\ndf_ibge['quantidade'] = df_ibge['quantidade'].astype('Int64')\n\n# Reorder columns\ndf_ibge = df_ibge[['local', 'sexo', 'faixa_etaria', 'situacao', 'raca', 'quantidade']]","metadata":{"trusted":true,"editable":true},"execution_count":15,"outputs":[]},{"cell_type":"code","source":"df_ibge.head()","metadata":{"trusted":true,"editable":true},"execution_count":16,"outputs":[{"execution_count":16,"output_type":"execute_result","data":{"text/plain":"          local    sexo  faixa_etaria      situacao    raca  quantidade\n0  Vila Paquetá  Homens  15 a 19 anos  alfabetizado  Branca           1\n1  Vila Paquetá  Homens  20 a 24 anos  alfabetizado  Branca           4\n2  Vila Paquetá  Homens  25 a 34 anos  alfabetizado  Branca           6\n3  Vila Paquetá  Homens  35 a 44 anos  alfabetizado  Branca           7\n4  Vila Paquetá  Homens  45 a 54 anos  alfabetizado  Branca        <NA>","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>local</th>\n      <th>sexo</th>\n      <th>faixa_etaria</th>\n      <th>situacao</th>\n      <th>raca</th>\n      <th>quantidade</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>Vila Paquetá</td>\n      <td>Homens</td>\n      <td>15 a 19 anos</td>\n      <td>alfabetizado</td>\n      <td>Branca</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>Vila Paquetá</td>\n      <td>Homens</td>\n      <td>20 a 24 anos</td>\n      <td>alfabetizado</td>\n      <td>Branca</td>\n      <td>4</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>Vila Paquetá</td>\n      <td>Homens</td>\n      <td>25 a 34 anos</td>\n      <td>alfabetizado</td>\n      <td>Branca</td>\n      <td>6</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>Vila Paquetá</td>\n      <td>Homens</td>\n      <td>35 a 44 anos</td>\n      <td>alfabetizado</td>\n      <td>Branca</td>\n      <td>7</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>Vila Paquetá</td>\n      <td>Homens</td>\n      <td>45 a 54 anos</td>\n      <td>alfabetizado</td>\n      <td>Branca</td>\n      <td>&lt;NA&gt;</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}]},{"cell_type":"code","source":"import re\nimport unicodedata\n\n# Função de normalização\ndef normalizar(texto):\n    if pd.isna(texto):\n        return \"\"\n    texto = texto.lower()\n    texto = unicodedata.normalize(\"NFKD\", texto).encode(\"ASCII\", \"ignore\").decode(\"utf-8\")\n    texto = re.sub(r\"[-]\", \" \", texto)  # quero remover os acentos\n    texto = re.sub(r'\\b(vila|favela|comunidade|bairro)\\b', '', texto)\n    texto = re.sub(r\"\\s+\", \" \", texto)\n    return texto.strip()\n\n# Aplica normalização\ndf_ibge['local'] = df_ibge['local'].apply(normalizar)\n\nmapeamento = {\n    \n    \"da paz\": \"da paz ou cachoeirinha\",\n    \"real i\": \"real 1\",\n    \"piratininga a\": \"piratininga venda nova\"\n}\n\ndf_ibge[\"local\"] = df_ibge[\"local\"].map(mapeamento).fillna(df_ibge[\"local\"])\n","metadata":{"trusted":true,"tags":[]},"execution_count":18,"outputs":[]},{"cell_type":"code","source":"df_ibge.head()","metadata":{"trusted":true,"tags":[]},"execution_count":19,"outputs":[{"execution_count":19,"output_type":"execute_result","data":{"text/plain":"     local    sexo  faixa_etaria      situacao    raca  quantidade\n0  paqueta  Homens  15 a 19 anos  alfabetizado  Branca           1\n1  paqueta  Homens  20 a 24 anos  alfabetizado  Branca           4\n2  paqueta  Homens  25 a 34 anos  alfabetizado  Branca           6\n3  paqueta  Homens  35 a 44 anos  alfabetizado  Branca           7\n4  paqueta  Homens  45 a 54 anos  alfabetizado  Branca        <NA>","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>local</th>\n      <th>sexo</th>\n      <th>faixa_etaria</th>\n      <th>situacao</th>\n      <th>raca</th>\n      <th>quantidade</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>paqueta</td>\n      <td>Homens</td>\n      <td>15 a 19 anos</td>\n      <td>alfabetizado</td>\n      <td>Branca</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>paqueta</td>\n      <td>Homens</td>\n      <td>20 a 24 anos</td>\n      <td>alfabetizado</td>\n      <td>Branca</td>\n      <td>4</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>paqueta</td>\n      <td>Homens</td>\n      <td>25 a 34 anos</td>\n      <td>alfabetizado</td>\n      <td>Branca</td>\n      <td>6</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>paqueta</td>\n      <td>Homens</td>\n      <td>35 a 44 anos</td>\n      <td>alfabetizado</td>\n      <td>Branca</td>\n      <td>7</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>paqueta</td>\n      <td>Homens</td>\n      <td>45 a 54 anos</td>\n      <td>alfabetizado</td>\n      <td>Branca</td>\n      <td>&lt;NA&gt;</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}]},{"cell_type":"code","source":"import boto3\nimport io\n\n# Buffer\ncsv_buffer = io.StringIO()\ndf_ibge.to_csv(csv_buffer, index=False)\n\n# Nome do bucket e caminho no S3\ns3_bucket = 'tcc-eng-software-vilas-favelas-bh'\ns3_key = 'processed/dados_ibge.csv'\n\n# Inicializar o cliente S3\ns3 = boto3.client('s3')\n\n# Send to S3\ns3.put_object(\n    Bucket=s3_bucket,\n    Key=s3_key,\n    Body=csv_buffer.getvalue()\n)\n\nprint(f\"✅ CSV enviado diretamente para s3://{s3_bucket}/{s3_key}\")","metadata":{"trusted":true,"tags":[]},"execution_count":21,"outputs":[{"name":"stdout","text":"✅ CSV enviado diretamente para s3://tcc-eng-software-vilas-favelas-bh/processed/dados_ibge.csv\n","output_type":"stream"}]},{"cell_type":"code","source":"","metadata":{},"execution_count":null,"outputs":[]}]}